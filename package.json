{
  "name": "todo",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@cloudflare/vitest-plugin": "^1.9.0",
    "drizzle-kit": "0.31.11",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vite-ssr-components": "^0.8.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.110.0"
  }
}